# Space-website Backend Environment Variables

# Copy this file to .env and fill in real values. Never commit .env to version control.

# DB connection (PostgreSQL)
DB_HOST=localhost
DB_NAME=project_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Frontend origin for CORS restriction
# Replace with your actual frontend URL (e.g., http://localhost:3000 or https://your-domain.com)
FRONTEND_ORIGIN=http://localhost:3000

# Space-Track API credentials (required for spacetrack ingestion)
# Obtain from https://www.space-track.org
SPACETRACK_USER=your_space_track_username
SPACETRACK_PASS=your_space_track_password

# DISCOS API token (required for discos ingestion)
# Obtain from https://discosweb.esoc.esa.int
DISCOS_TOKEN=your_discos_api_token

# Google Gemini API key (required for AI provider)
# Obtain from https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key

# Optional: override default ingestion resume points
# DISCOS_START_PAGE=1